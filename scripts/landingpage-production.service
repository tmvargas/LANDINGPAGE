[Unit]
Description=PlanSmart LANDINGPAGE production
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/plansmart/sistemas/landingpage
EnvironmentFile=/etc/plansmart/landingpage-production.env
ExecStart=/opt/plansmart/sistemas/landingpage/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:6105 --access-logfile - --error-logfile - run:app
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
